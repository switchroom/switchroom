# Example only: the plain cron alternative to the systemd units. Install into
# root's crontab (crontab -e) or /etc/cron.d/ (add the user field "root" after
# the schedule there). Cron mails or logs any output; a non-zero exit is a failure.
#
# Exit codes: 0 ok/pass, 1 backup or restore check failed, 2 config error,
#             3 disabled in the config, 4 another run holds the lock.
SHELL=/bin/sh
PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Nightly backup at 02:30.
30 2 * * * umask 077; /usr/bin/python3 -I -B /opt/switchroom/scripts/switchroom-volume-backup.py backup --config /etc/switchroom/volume-backup/example-agent.json >/dev/null || echo "volume backup failed for example-agent (exit $?)"

# Weekly restore check on Sunday at 05:00.
0 5 * * 0 umask 077; /usr/bin/python3 -I -B /opt/switchroom/scripts/switchroom-volume-backup.py restore-check --config /etc/switchroom/volume-backup/example-agent.json >/dev/null || echo "restore check failed for example-agent (exit $?)"
