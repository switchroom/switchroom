{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Switchroom secret-reference map",
  "description": "Which 1Password vault items each agent may read. Holds names only, never a secret value. scripts/switchroom-secret-reference-audit.py enforces the same rules.",
  "type": "object",
  "required": [
    "schema",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "switchroom-secret-references/1"
    },
    "description": {
      "type": "string"
    },
    "agents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vaults": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/segment"
            },
            "uniqueItems": true,
            "description": "Vaults this agent owns. No two agents may own the same vault."
          },
          "references": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[A-Z_][A-Z0-9_]{0,127}$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/reference"
            },
            "description": "Environment variable name to the vault item that fills it."
          }
        }
      }
    },
    "shared": {
      "type": "array",
      "description": "Items more than one agent may read, each named explicitly with its readers.",
      "items": {
        "type": "object",
        "required": [
          "vault",
          "item",
          "readers"
        ],
        "additionalProperties": false,
        "properties": {
          "vault": {
            "$ref": "#/$defs/segment"
          },
          "item": {
            "$ref": "#/$defs/segment"
          },
          "readers": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^/\\s\\u0000-\\u001f\\u007f](?:[^/\\u0000-\\u001f\\u007f]*[^/\\s\\u0000-\\u001f\\u007f])?$"
    },
    "reference": {
      "type": "object",
      "required": [
        "vault",
        "item",
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "vault": {
          "$ref": "#/$defs/segment"
        },
        "item": {
          "$ref": "#/$defs/segment"
        },
        "section": {
          "$ref": "#/$defs/segment"
        },
        "field": {
          "$ref": "#/$defs/segment"
        }
      }
    }
  }
}
