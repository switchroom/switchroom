{
  "schema_version": 1,
  "status": "public_product_skeleton",
  "public_base": {
    "policy": "reviewed_default_set",
    "decision_record": "reference/rfcs/default-on-distribution.md",
    "starter_overlay": "planned",
    "default_statuses": [
      "planned",
      "shipped"
    ],
    "starter_overlay_values": [
      "configured",
      "not_configured"
    ],
    "billing_values": [
      "none",
      "principal_plan_login",
      "operator_supplied_key"
    ],
    "opt_out": "one_line_per_agent",
    "missing_credential": "disable_report_in_setup_check_never_block_start",
    "default_set": [
      {
        "id": "doctrine-config",
        "status": "planned",
        "starter_overlay": "configured",
        "summary": "Working doctrine config: system prompt, smart approvals, queue-first chat, verify-on-stop.",
        "covers": [],
        "credential": {
          "kind": "none"
        },
        "degrade": {
          "when": "never_missing",
          "behaviour": "always_on"
        },
        "billing": "none",
        "blocks_agent_start": false
      },
      {
        "id": "gateway-per-agent",
        "status": "planned",
        "starter_overlay": "configured",
        "summary": "One gateway per agent, pinned with gateway.multiplex_profiles: false.",
        "covers": [],
        "credential": {
          "kind": "none"
        },
        "degrade": {
          "when": "never_missing",
          "behaviour": "always_on"
        },
        "billing": "none",
        "blocks_agent_start": false,
        "pinned_config": {
          "gateway.multiplex_profiles": false
        }
      },
      {
        "id": "secrets-connect",
        "status": "planned",
        "starter_overlay": "configured",
        "summary": "1Password Connect secrets per container, with an env-file fallback.",
        "covers": [],
        "credential": {
          "kind": "per_agent_connect_token",
          "fallback": "env_file"
        },
        "degrade": {
          "when": "connect_unset",
          "behaviour": "use_env_file_and_report"
        },
        "billing": "none",
        "blocks_agent_start": false
      },
      {
        "id": "coding-clis",
        "status": "planned",
        "starter_overlay": "configured",
