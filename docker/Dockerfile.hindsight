        "                    remaining_reserved[op_type] -= 1\n"
        "                else:\n"
        "                    remaining_shared -= 1\n",

        "        def _account_tasks(tasks: list[ClaimedTask]) -> None:\n"
        "            nonlocal remaining_shared\n"
        "            for task in tasks:\n"
