        "covers": [],
        "credential": {
          "kind": "per_agent_cli_login"
        },
        "degrade": {
          "when": "login_missing",
          "behaviour": "disable_and_report"
        },
        "billing": "principal_plan_login",
        "blocks_agent_start": false,
        "expected": [
          "claude",
          "codex",
          "grok",
          "opencode"
        ]
      },
      {
        "id": "model-roles",
        "status": "planned",
        "starter_overlay": "configured",
