#!/bin/bash
# Supervised camofox-browser for this container (s6 longrun "camofox-browser").
#
# One Node process on loopback, opening Camoufox headed on the profile's Bot Desktop. The browser
# itself starts lazily on the first request, so the service costs ~40 MB until something browses.
# DISPLAY/XAUTHORITY come from the screen's published env file, falling back to the display a
# single-profile container's screen gets (:20). The server runs only while that display's X server
# is up: while the Bot Desktop is stopped (idle-stop, or not started yet after a container start)
# this waits instead of letting the server retry a browser launch every 30 s against a dead display.
# When the screen stops or comes back on a different display the service exits and s6 restarts it.
# SIGTERM is forwarded so camofox-browser writes its cookie checkpoint before exiting.
set -euo pipefail

home_dir=${HERMES_HOME:-/opt/data}
state=${CAMOFOX_STATE_DIR:-$home_dir/camofox-browser}
desktop_env=$home_dir/bot-desktop/env
install_dir=${CAMOFOX_SERVER_DIR:-/opt/camofox-browser}
# The kernel's table of bound Unix sockets (tests point it at a fixture).
x_socket_table=${CAMOFOX_X_SOCKET_TABLE:-/proc/net/unix}
# The time-zone fallback when TZ is empty (tests point it at a fixture).
timezone_file=${CAMOFOX_TIMEZONE_FILE:-/etc/timezone}
backoff_seconds=${CAMOFOX_BACKOFF_SECONDS:-30}

# s6 restarts a failed run at once; an unusable state directory (a read-only or not-yet-owned
# volume) would otherwise spin and flood the log, so wait before giving up.
backoff_exit() {
  echo "camofox-browser: $1; retrying in ${backoff_seconds} s" >&2
  sleep "$backoff_seconds"
  exit 1
}

umask 077
mkdir -p "$state/profiles" "$state/cookies" "$state/uploads" "$state/traces" "$state/home" \
  || backoff_exit "cannot create $state"
chmod 0700 "$state" || backoff_exit "cannot secure $state"

key=$state/access-key
key_usable() {
  [ -s "$key" ] && [ "$(tr -d '[:space:]' < "$key" | wc -c)" -ge 32 ]
}
if ! key_usable; then
  tmp=$(mktemp "$state/.access-key.XXXXXX") || backoff_exit "cannot write in $state"
  if ! od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$tmp" || ! printf '\n' >> "$tmp"; then
    rm -f "$tmp"
    backoff_exit "cannot generate an access key"
  fi
  if [ -e "$key" ]; then
    # An empty key left by a crash or a full disk, or a short one nothing can use (the plugin
    # refuses keys under 32 characters too): replace it.
    echo "camofox-browser: replacing an unusable access key" >&2
    mv -f "$tmp" "$key"
  else
    ln "$tmp" "$key" 2>/dev/null || true  # first writer wins against the plugin
    rm -f "$tmp"
  fi
fi
access_key=$(tr -d '[:space:]' < "$key")
[ "${#access_key}" -ge 32 ] || backoff_exit "access key at $key is too short"

published_display() {
  [ -r "$desktop_env" ] || return 0
  sed -n 's/^DISPLAY=//p' "$desktop_env" | head -n1
}

current_display() {
  local d
  d=$(published_display)
  printf '%s' "${d:-${CAMOFOX_DISPLAY:-:20}}"
}

# A running X server keeps /tmp/.X11-unix/X<n> (and its abstract twin) bound for its whole life.
# The env file alone is not proof: it outlives the screen across a container recreate.
x_live() {
  local n=${1#*:}
  n=${n%%.*}
  [ -n "$n" ] && grep -qE " @?/tmp/\.X11-unix/X${n}\$" "$x_socket_table" 2>/dev/null
}

trap 'exit 0' TERM INT
display=$(current_display)
if ! x_live "$display"; then
  echo "camofox-browser: waiting for the Bot Desktop ($display) before starting" >&2
  until x_live "$display"; do
    sleep 1 & wait $! || true
    display=$(current_display)
  done
fi

xauth=$home_dir/bot-desktop/Xauthority
if [ -r "$desktop_env" ]; then
  published_xauth=$(sed -n 's/^XAUTHORITY=//p' "$desktop_env" | head -n1)
  xauth=${published_xauth:-$xauth}
  bus=$(sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' "$desktop_env" | head -n1)
  [ -n "$bus" ] && export DBUS_SESSION_BUS_ADDRESS="$bus"
fi

export HOME="$state/home"
export DISPLAY="$display" XAUTHORITY="$xauth"
export CAMOFOX_PORT=${CAMOFOX_PORT:-9377}
export CAMOFOX_BIND_HOST=127.0.0.1
export CAMOFOX_ACCESS_KEY="$access_key" CAMOFOX_API_KEY="$access_key"
export CAMOFOX_INTERACTIVE=desktop
export CAMOUFOX_EXECUTABLE=${CAMOUFOX_EXECUTABLE:-/opt/camoufox/camoufox-bin}
export CAMOUFOX_FPGEN_DATA=${CAMOUFOX_FPGEN_DATA:-/opt/camofox-browser/fpgen}
export CAMOFOX_PROFILE_DIR="$state/profiles" CAMOFOX_COOKIES_DIR="$state/cookies"
export CAMOFOX_UPLOADS_DIR="$state/uploads" CAMOFOX_TRACES_DIR="$state/traces"
export CAMOFOX_CRASH_REPORT_ENABLED=false SENTRY_DSN= PROMETHEUS_ENABLED=false
export CAMOFOX_DISABLE_DEFAULT_ADDONS=${CAMOFOX_DISABLE_DEFAULT_ADDONS:-1}
export CAMOFOX_OS=${CAMOFOX_OS:-linux}
# One browser identity from the container's own locale and time zone: without the pair the browser
# reports navigator.language en-US while Intl follows the container. camofox-browser takes both or
# neither (it refuses half a pair at start), so explicit values pass through as given, and derived
# ones are exported only when both resolve.
if [ -z "${CAMOFOX_LOCALE:-}" ] && [ -z "${CAMOFOX_TIMEZONE:-}" ]; then
  derived_locale=${LC_ALL:-${LANG:-}}
  derived_locale=${derived_locale%%.*}
  derived_locale=${derived_locale%%@*}
  derived_locale=${derived_locale//_/-}
  case "$derived_locale" in C | POSIX) derived_locale= ;; esac
  derived_timezone=${TZ:-}
  derived_timezone=${derived_timezone#:}
  if [ -z "$derived_timezone" ] && [ -r "$timezone_file" ]; then
    derived_timezone=$(head -n1 "$timezone_file" | tr -d '[:space:]')
  fi
  if [ -n "$derived_locale" ] && [ -n "$derived_timezone" ]; then
    export CAMOFOX_LOCALE="$derived_locale" CAMOFOX_TIMEZONE="$derived_timezone"
  else
    unset CAMOFOX_LOCALE CAMOFOX_TIMEZONE
  fi
fi
# A human shares these windows: never expire a session on idleness, keep a quiet tab for 8 h
# (0 is not "off" for TAB_INACTIVITY_MS), and let the browser use more memory before a restart.
export SESSION_TIMEOUT_MS=${SESSION_TIMEOUT_MS:-0}
export TAB_INACTIVITY_MS=${TAB_INACTIVITY_MS:-28800000}
export BROWSER_RSS_RESTART_THRESHOLD_MB=${BROWSER_RSS_RESTART_THRESHOLD_MB:-3000}
export CAMOFOX_SHUTDOWN_TIMEOUT_MS=${CAMOFOX_SHUTDOWN_TIMEOUT_MS:-40000}
export NODE_ENV=production
unset ENABLE_VNC

cd "$install_dir"
node --max-old-space-size=256 server.js &
child=$!

stop() {
  kill -TERM "$child" 2>/dev/null || true
  wait "$child" 2>/dev/null || true
  exit 0
}
trap stop TERM INT

while kill -0 "$child" 2>/dev/null; do
  sleep "${CAMOFOX_WATCH_SECONDS:-15}" & wait $! || true
  now=$(published_display)
  if [ -n "$now" ] && [ "$now" != "$display" ]; then
    echo "camofox-browser: Bot Desktop moved from $display to $now; restarting on the new display" >&2
    stop
  fi
  if ! x_live "$display"; then
    echo "camofox-browser: Bot Desktop ($display) stopped; waiting for it to return" >&2
    stop
  fi
done
wait "$child"
