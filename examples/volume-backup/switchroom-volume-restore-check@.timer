# Example only. Weekly restore check: systemctl enable --now switchroom-volume-restore-check@<agent>.timer
[Unit]
Description=Weekly restore check of Switchroom agent %i backups

[Timer]
OnCalendar=Sun *-*-* 05:00:00
RandomizedDelaySec=30m
Persistent=true
Unit=switchroom-volume-restore-check@%i.service

[Install]
WantedBy=timers.target
